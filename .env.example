# Optional. Where the feedback widget POSTs submissions — a Google Apps Script
# web app URL ending in /exec.
#
# Leave unset and feedback stays in the browser's localStorage only, and nothing
# is transmitted anywhere. Copy this file to .env.local (gitignored) to set it.
#
# Note: this value is compiled into the client bundle, so it is public on the
# deployed site. It grants write access to the script only, never read access to
# the sheet.
# VITE_FEEDBACK_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional. Google OAuth client ID, used to sign in the staff who may upload
# decks. Public by design; a client ID is not a secret.
# VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com

# Optional. Apps Script web app that stores uploaded decks (see apps-script/
# decks.gs). GET returns published decks, POST accepts one from an allowlisted
# account.
#
# The allowlist lives in that script's Script Properties, never here and never
# in the repo. This URL being public only grants what the script permits, which
# is reading published decks and submitting one with a verified Google token.
#
# With both unset the upload ticket stays inert and nothing is fetched.
# VITE_DECKS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional. Apps Script web app that receives the contact form (see
# apps-script/contact.gs). Your address lives in that script's Script
# Properties, not here, so it is not committed to a public repo.
#
# With this unset the form still validates and tells the visitor to email you
# directly instead of pretending to send.
# VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# ---------------------------------------------------------------------------
# One Apps Script web app serves feedback, the contact form and deck uploads.
# A web app can only export one doPost, so all three POST to this URL and the
# script routes on a `type` field. See apps-script/grignard.gs.
#
# The per-feature variables below still work and take precedence, so an
# existing deployment keeps running until you switch over.
# VITE_APPS_SCRIPT_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
