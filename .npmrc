# npm's dependency resolver crashes on this tree with
# "Cannot read properties of null (reading 'edgesOut')" when it tries to solve
# the peer graph. The conflict comes from ketcher-react 3.14: it pulls
# miew-react 0.11, which declares a peer of react-dom ^18.2, against this
# repo's react-dom 19.2. draft-js-custom-styles adds a second conflicting peer
# on draft-js. Neither is satisfiable, and arborist crashes rather than
# reporting it.
#
# This does not silence a real check. Peer ranges are advisory metadata, and
# the app runs correctly on React 19 today. Removing this line means no install
# works at all, so it stays until ketcher-react is either upgraded or dropped.
legacy-peer-deps=true
