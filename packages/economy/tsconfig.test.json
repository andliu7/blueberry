{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // Same shape as packages/curriculum/tsconfig.test.json. This package has no
  // dependency on chem-core or on any other workspace package, so the project
  // reference below is the only one there is.
  "include": ["test/**/*.ts", "vitest.config.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}
