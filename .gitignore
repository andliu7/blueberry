# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# TypeScript incremental build stamps. `dist` above does not catch these: most
# packages point tsBuildInfoFile into dist/, but a tsconfig that does not lands
# the stamp beside itself, where nothing was ignoring it. One got committed that
# way and broke the deploy: CI read the stamp, decided chem-core was up to date,
# emitted no dist/, and every package importing @blueberry/chem-core failed to
# resolve it. The build was green locally the whole time, because locally the
# dist/ it was describing actually existed.
*.tsbuildinfo
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env (may contain endpoint URLs)
.env
.env.local
.env.*.local

# Python bytecode from the curriculum build scripts
__pycache__/
*.pyc

# Agent tooling state, not project source
.agents/
.claude/
skills-lock.json

# Built output. GitHub Actions builds and deploys to Pages, so a copy of the
# site is no longer committed. It reached 132MB and broke `git push` outright.
docs/

.vercel
.env*

# Blind-judge screenshots. Regenerated per round, never reviewed as source.
.gauntlet/
